# Example secrets file for ocinbox
# Copy this to secrets.env and fill in your actual API / GH keys
# This file is passed via --env-file to Docker/Apptainer
# NEVER commit secrets.env with real keys

ALAN_API_KEY=replace_me
MISTRAL_API_KEY=replace_me

GH_TOKEN=replace_me
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=your-verified-or-noreply-github-email
GIT_COMMITTER_NAME=Your Name
GIT_COMMITTER_EMAIL=your-verified-or-noreply-github-email